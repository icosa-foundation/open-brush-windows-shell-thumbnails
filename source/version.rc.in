#include <winver.h>

// Open Brush icon resource
1 ICON "@CMAKE_SOURCE_DIR@/resources/openbrush-icon.ico"

VS_VERSION_INFO	VERSIONINFO
	FILEVERSION     @BUILD_YEAR@,@BUILD_MONTH@,@BUILD_DAY@,0
	FILEFLAGSMASK	0x17L
	FILEFLAGS		VS_FF_SPECIALBUILD
	FILEOS			VOS_UNKNOWN
	FILETYPE		VFT_DLL
	FILESUBTYPE		VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName",		"Open Brush"
			VALUE "FileDescription",	"Open Brush Tilt Thumbnail Handler"
			VALUE "InternalName",		"TiltThumbs"
			VALUE "LegalCopyright",		"Copyright (C) 2025, Open Brush contributors"
			VALUE "OriginalFilename",	"TiltThumbs.dll"
			VALUE "ProductName",		"TiltThumbs"
			VALUE "ProductVersion",		"@BUILD_YEAR@.@BUILD_MONTH@.@BUILD_DAY@.@GIT_HASH@"
			VALUE "SpecialBuild",		"@GIT_HASH@"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1252
	END
END
